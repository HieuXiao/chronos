{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chronos",
  "version": "0.1.0",
  "identifier": "chronos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chronos",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#f7f6f3",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Ngo Minh Hieu",
    "shortDescription": "Theo dõi thời gian làm việc",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["Vietnamese"],
        "displayLanguageSelector": false
      }
    }
  }
}
